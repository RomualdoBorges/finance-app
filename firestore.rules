rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isCurrentUser(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function personalMembershipPath(userId) {
      return /databases/$(database)/documents/groupMembers/$(userId);
    }

    function personalGroupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    function isGroupMember(groupId) {
      return request.auth != null
        && exists(personalMembershipPath(request.auth.uid))
        && get(personalMembershipPath(request.auth.uid)).data.groupId == groupId
        && get(personalMembershipPath(request.auth.uid)).data.userId == request.auth.uid
        && get(personalMembershipPath(request.auth.uid)).data.role == 'OWNER';
    }

    function hasOnlyUserProfileFields() {
      return request.resource.data.keys().hasOnly([
        'email',
        'displayName',
        'photoURL',
        'activeGroupId',
        'createdAt',
        'updatedAt'
      ]);
    }

    function hasAllUserProfileFields() {
      return request.resource.data.keys().hasAll([
        'email',
        'displayName',
        'photoURL',
        'createdAt',
        'updatedAt'
      ]);
    }

    function hasValidNullableStrings() {
      return (request.resource.data.email == null
          || request.resource.data.email is string)
        && (request.resource.data.displayName == null
          || request.resource.data.displayName is string)
        && (request.resource.data.photoURL == null
          || request.resource.data.photoURL is string);
    }

    function hasValidUserProfileShape() {
      return hasOnlyUserProfileFields()
        && hasAllUserProfileFields()
        && hasValidNullableStrings()
        && (!request.resource.data.keys().hasAny(['activeGroupId'])
          || request.resource.data.activeGroupId is string)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function hasValidActiveGroup() {
      return !request.resource.data.keys().hasAny(['activeGroupId'])
        || (
          exists(personalGroupPath(request.resource.data.activeGroupId))
          && exists(personalMembershipPath(request.auth.uid))
          && get(personalMembershipPath(request.auth.uid)).data.groupId
            == request.resource.data.activeGroupId
          && get(personalMembershipPath(request.auth.uid)).data.userId
            == request.auth.uid
          && get(personalMembershipPath(request.auth.uid)).data.role == 'OWNER'
        );
    }

    match /users/{userId} {
      allow read: if isCurrentUser(userId);

      allow create: if isCurrentUser(userId)
        && hasValidUserProfileShape()
        && hasValidActiveGroup()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isCurrentUser(userId)
        && hasValidUserProfileShape()
        && hasValidActiveGroup()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /groups/{groupId} {
      // A leitura do próprio ID permite verificar a ausência durante o
      // bootstrap transacional; grupos existentes só podem ter esse owner.
      allow read: if isGroupMember(groupId)
        || (request.auth != null && request.auth.uid == groupId);

      allow create: if request.auth != null
        && request.auth.uid == groupId
        && request.resource.data.keys().hasOnly([
          'name',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'name',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.name == 'Meu Financeiro'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && getAfter(personalMembershipPath(request.auth.uid)).data.groupId == groupId
        && getAfter(personalMembershipPath(request.auth.uid)).data.userId == request.auth.uid
        && getAfter(personalMembershipPath(request.auth.uid)).data.role == 'OWNER';

      allow update, delete: if false;
    }

    match /groupMembers/{membershipId} {
      allow read: if isCurrentUser(membershipId);

      allow create: if isCurrentUser(membershipId)
        && request.resource.data.keys().hasOnly([
          'groupId',
          'userId',
          'role',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'groupId',
          'userId',
          'role',
          'createdAt'
        ])
        && request.resource.data.groupId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.role == 'OWNER'
        && request.resource.data.createdAt == request.time
        && getAfter(personalGroupPath(request.auth.uid)).data.name == 'Meu Financeiro';

      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
