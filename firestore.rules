rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isCurrentUser(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function hasOnlyUserProfileFields() {
      return request.resource.data.keys().hasOnly([
        'email',
        'displayName',
        'photoURL',
        'createdAt',
        'updatedAt'
      ]);
    }

    function hasAllUserProfileFields() {
      return request.resource.data.keys().hasAll([
        'email',
        'displayName',
        'photoURL',
        'createdAt',
        'updatedAt'
      ]);
    }

    function hasValidNullableStrings() {
      return (request.resource.data.email == null
          || request.resource.data.email is string)
        && (request.resource.data.displayName == null
          || request.resource.data.displayName is string)
        && (request.resource.data.photoURL == null
          || request.resource.data.photoURL is string);
    }

    function hasValidUserProfileShape() {
      return hasOnlyUserProfileFields()
        && hasAllUserProfileFields()
        && hasValidNullableStrings()
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow read: if isCurrentUser(userId);

      allow create: if isCurrentUser(userId)
        && hasValidUserProfileShape()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isCurrentUser(userId)
        && hasValidUserProfileShape()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
