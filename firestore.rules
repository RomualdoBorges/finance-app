rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function groupPath(groupId) {
      return /databases/$(database)/documents/financialGroups/$(groupId);
    }

    function membershipPath(groupId, userId) {
      return /databases/$(database)/documents/financialGroups/$(groupId)/members/$(userId);
    }

    function categoryPath(groupId, categoryId) {
      return /databases/$(database)/documents/financialGroups/$(groupId)/categories/$(categoryId);
    }

    function isActiveOwnerMembership(membership) {
      return membership.data.userId == request.auth.uid
        && membership.data.role == 'owner'
        && membership.data.status == 'active';
    }

    function isActiveMember(groupId) {
      return isAuthenticated()
        && exists(membershipPath(groupId, request.auth.uid))
        && isActiveOwnerMembership(
          get(membershipPath(groupId, request.auth.uid))
        );
    }

    function hasOnlyUserProfileFields() {
      return request.resource.data.keys().hasOnly([
        'email',
        'displayName',
        'photoURL',
        'activeGroupId',
        'createdAt',
        'updatedAt'
      ]);
    }

    function hasAllUserProfileFields() {
      return request.resource.data.keys().hasAll([
        'email',
        'displayName',
        'photoURL',
        'createdAt',
        'updatedAt'
      ]);
    }

    function hasValidNullableStrings() {
      return (request.resource.data.email == null
          || request.resource.data.email is string)
        && (request.resource.data.displayName == null
          || request.resource.data.displayName is string)
        && (request.resource.data.photoURL == null
          || request.resource.data.photoURL is string);
    }

    function hasValidUserProfileShape() {
      return hasOnlyUserProfileFields()
        && hasAllUserProfileFields()
        && hasValidNullableStrings()
        && (!request.resource.data.keys().hasAny(['activeGroupId'])
          || (request.resource.data.activeGroupId is string
            && request.resource.data.activeGroupId.size() > 0))
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function hasValidActiveGroup() {
      return !request.resource.data.keys().hasAny(['activeGroupId'])
        || (
          exists(groupPath(request.resource.data.activeGroupId))
          && exists(
            membershipPath(
              request.resource.data.activeGroupId,
              request.auth.uid
            )
          )
          && isActiveOwnerMembership(
            get(
              membershipPath(
                request.resource.data.activeGroupId,
                request.auth.uid
              )
            )
          )
        );
    }

    function hasValidGroupShape(groupId) {
      return request.resource.data.keys().hasOnly([
          'name',
          'type',
          'currency',
          'ownerId',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'name',
          'type',
          'currency',
          'ownerId',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && groupId.size() > 0
        && request.resource.data.name == 'Meu Financeiro'
        && request.resource.data.type == 'personal'
        && request.resource.data.currency == 'BRL'
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function hasValidOwnerMembershipShape(groupId, userId) {
      return request.resource.data.keys().hasOnly([
          'userId',
          'groupId',
          'role',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'userId',
          'groupId',
          'role',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && isSelf(userId)
        && request.resource.data.userId == userId
        && request.resource.data.groupId == groupId
        && request.resource.data.role == 'owner'
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function hasValidCategoryShape(groupId) {
      return request.resource.data.keys().hasOnly([
          'groupId',
          'name',
          'normalizedName',
          'type',
          'origin',
          'status',
          'parentCategoryId',
          'icon',
          'createdBy',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'groupId',
          'name',
          'normalizedName',
          'type',
          'origin',
          'status',
          'parentCategoryId',
          'icon',
          'createdBy',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.groupId == groupId
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && request.resource.data.normalizedName is string
        && request.resource.data.normalizedName.size() >= 2
        && request.resource.data.normalizedName.size() <= 60
        && request.resource.data.type in ['income', 'expense']
        && request.resource.data.origin in ['default', 'custom']
        && request.resource.data.status == 'active'
        && (request.resource.data.parentCategoryId == null
          || request.resource.data.parentCategoryId is string)
        && (request.resource.data.icon == null
          || (request.resource.data.icon is string
            && request.resource.data.icon.size() <= 40))
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function hasValidCategoryParent(groupId) {
      let parentId = request.resource.data.parentCategoryId;
      return parentId == null
        || (
          parentId.size() > 0
          && existsAfter(categoryPath(groupId, parentId))
          && getAfter(categoryPath(groupId, parentId)).data.groupId == groupId
          && getAfter(categoryPath(groupId, parentId)).data.status == 'active'
          && getAfter(categoryPath(groupId, parentId)).data.parentCategoryId == null
          && getAfter(categoryPath(groupId, parentId)).data.type == request.resource.data.type
        );
    }

    match /users/{userId} {
      allow read: if isSelf(userId);

      allow create: if isSelf(userId)
        && hasValidUserProfileShape()
        && hasValidActiveGroup()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isSelf(userId)
        && hasValidUserProfileShape()
        && hasValidActiveGroup()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /financialGroups/{groupId} {
      // A transação de bootstrap precisa ler a ausência do grupo determinístico.
      allow get: if isActiveMember(groupId)
        || (isSelf(groupId) && !exists(groupPath(groupId)));
      allow list: if false;

      allow create: if isAuthenticated()
        && groupId == request.auth.uid
        && hasValidGroupShape(groupId)
        && existsAfter(membershipPath(groupId, request.auth.uid))
        && isActiveOwnerMembership(
          getAfter(membershipPath(groupId, request.auth.uid))
        );

      allow update, delete: if false;

      match /members/{userId} {
        // A mesma transação precisa ler a ausência do membership determinístico.
        allow get: if isSelf(userId)
          && (
            isActiveMember(groupId)
            || (
              groupId == request.auth.uid
              && !exists(membershipPath(groupId, userId))
            )
          );
        allow list: if false;

        allow create: if hasValidOwnerMembershipShape(groupId, userId)
          && existsAfter(groupPath(groupId))
          && getAfter(groupPath(groupId)).data.ownerId == request.auth.uid
          && getAfter(groupPath(groupId)).data.type == 'personal'
          && getAfter(groupPath(groupId)).data.status == 'active';

        allow update, delete: if false;
      }

      match /categories/{categoryId} {
        allow read: if isActiveMember(groupId);

        allow create: if isActiveMember(groupId)
          && categoryId.size() > 0
          && hasValidCategoryShape(groupId)
          && hasValidCategoryParent(groupId);

        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
