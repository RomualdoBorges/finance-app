{
  "name": "finance-app",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{js,ts,json,html,yaml,yml}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{js,ts,json,html,yaml,yml}\"",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "firebase:emulators": "firebase emulators:start --only auth,firestore,functions,storage,hosting",
    "firebase:emulators:export": "firebase emulators:export .firebase/emulator-data",
    "firebase:emulators:import": "firebase emulators:start --only auth,firestore,functions,storage,hosting --import=.firebase/emulator-data --export-on-exit=.firebase/emulator-data",
    "firebase:emulators:clean": "node -e \"require('node:fs').rmSync('.firebase/emulator-data',{recursive:true,force:true})\"",
    "firebase:emulators:exec": "firebase emulators:exec --only auth,firestore,functions,storage,hosting \"pnpm functions:typecheck\"",
    "functions:build": "pnpm --dir functions build",
    "functions:typecheck": "pnpm --dir functions typecheck",
    "validate": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:run && pnpm build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@tanstack/react-query": "^5.101.4",
    "date-fns": "^4.4.0",
    "firebase": "^12.16.0",
    "lucide-react": "^1.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.83.0",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.10.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "firebase-tools": "^15.24.0",
    "globals": "^17.7.0",
    "jsdom": "^30.0.0",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
